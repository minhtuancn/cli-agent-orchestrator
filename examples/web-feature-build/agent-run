#!/usr/bin/env bash
# agent-run — launch the CAO "web-feature-build" supervisor on a REAL TTY.
#
# Single-server design (port 9889, auth ON):
#   The supervisor/workers call the CAO REST API (via cao-mcp-server) from
#   127.0.0.1. The server grants a LOOPBACK AUTH BYPASS for 127.0.0.1/::1, so
#   internal agent calls succeed WITHOUT a session cookie, while the public
#   reverse-proxy front (agent.go7s.net -> 9889) still requires login. One
#   server, one domain, auth stays on for humans.
#   (Override with CAO_API_PORT=9887 if you still want a separate auth-off box.)
#
# Usage:
#   agent-run                       # provider=opencode_cli, session=web-feat
#   agent-run --provider codex      # pick a provider
#   agent-run --session my-build    # custom session name
#   CAO_EXAMPLES=/path agent-run    # point at a different example dir
#
# After launch you land inside the supervisor terminal (tmux). Type your
# feature request, then press Ctrl+J to submit (OpenCode TUI uses Ctrl+J,
# NOT Enter, to send the prompt). The supervisor should then delegate to
# web_developer/web_tester via cao-assign — it must NOT implement itself.
set -euo pipefail

CAO_PORT="${CAO_API_PORT:-9889}"           # public server; loopback bypass lets agents call it
PROVIDER="${CAO_PROVIDER:-opencode_cli}"
SESSION="${CAO_SESSION_NAME:-web-feat}"
EXAMPLE_DIR="${CAO_EXAMPLES:-/home/dev/cao-web-patch/examples/web-feature-build}"
PROFILES=(web_feature_supervisor web_developer web_tester web_reviewer web_documenter)

log()  { printf '\033[36m▶\033[0m %s\n' "$*"; }
ok()   { printf '\033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '\033[33m⚠\033[0m %s\n' "$*"; }

ensure_server() {
  if curl -s -m 3 "http://127.0.0.1:${CAO_PORT}/health" >/dev/null 2>&1; then
    ok "cao-server already up on :${CAO_PORT}"
    return 0
  fi
  log "starting cao-server on :${CAO_PORT} (loopback bypass for agents)…"
  # Loopback (127.0.0.1) is auth-exempt; external callers still need login.
  CAO_ALLOWED_HOSTS="${CAO_ALLOWED_HOSTS:-localhost,127.0.0.1,agent.go7s.net}" \
  CAO_WS_ALLOWED_CLIENTS="${CAO_WS_ALLOWED_CLIENTS:-*}" \
    nohup cao-server --host 0.0.0.0 --port "${CAO_PORT}" >"/tmp/cao_${CAO_PORT}.log" 2>&1 &
  for _ in $(seq 1 30); do
    curl -s -m 2 "http://127.0.0.1:${CAO_PORT}/health" >/dev/null 2>&1 && break
    sleep 1
  done
  if curl -s -m 3 "http://127.0.0.1:${CAO_PORT}/health" >/dev/null 2>&1; then
    ok "cao-server ready on :${CAO_PORT}"
  else
    warn "cao-server did not come up — see /tmp/cao_${CAO_PORT}.log"
    exit 1
  fi
}

install_profiles() {
  log "installing profiles from ${EXAMPLE_DIR}"
  for p in "${PROFILES[@]}"; do
    if cao install "${EXAMPLE_DIR}/${p}.md" >/dev/null 2>&1; then
      ok "${p}"
    else
      warn "${p} install failed (missing file?)"
    fi
  done
}

launch() {
  log "launching supervisor (provider=${PROVIDER}, session=${SESSION})"
  echo "  → You are now inside the supervisor terminal. Type your feature request."
  # CAO_API_PORT is exported so cao-mcp-server inside workers targets 9887.
  export CAO_API_PORT
  exec cao launch --agents web_feature_supervisor \
    --provider "${PROVIDER}" \
    --session-name "${SESSION}" \
    --auto-approve --yolo
}

main() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --provider) PROVIDER="$2"; shift 2 ;;
      --session)  SESSION="$2";  shift 2 ;;
      -h|--help)  sed -n '2,20p' "$0"; exit 0 ;;
      *) warn "unknown arg: $1"; shift ;;
    esac
  done
  ensure_server
  install_profiles
  launch
}

main "$@"
